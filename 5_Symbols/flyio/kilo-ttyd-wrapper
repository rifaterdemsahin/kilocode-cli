#!/bin/bash
# kilo-ttyd-wrapper — runs kilo CLI in a way that works inside ttyd browser terminal
# The Go TUI binary hangs in ttyd due to incomplete TTY support.
# This wrapper detects limited environments and forces non-interactive mode.

KILO_REAL_BIN="/usr/lib/node_modules/@kilocode/cli/node_modules/@kilocode/cli-linux-x64/bin/kilo"

# Logic for forcing non-TUI mode:
# 1. We are in a ttyd session (TTYD_SESSION=true) AND NOT inside tmux
# 2. OR stdout is not a terminal ([ ! -t 1 ])
# 3. OR the terminal is explicitly 'dumb'
if { [ -n "${TTYD_SESSION:-}" ] && [ -z "${TMUX:-}" ]; } || [ ! -t 1 ] || [ "${TERM:-}" = "dumb" ]; then
    # Run binary and pipe output through cat to disable TUI features
    # Use 2>&1 to ensure error messages are also captured and piped
    "$KILO_REAL_BIN" "$@" 2>&1 | cat
    exit $?
fi

# Real terminal (SSH) or Virtual PTY (tmux) — run with full TUI
exec "$KILO_REAL_BIN" "$@"
